{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "anandsiddharth/laravel-paytm-wallet": "^2.0",
        "anhskohbo/no-captcha": "^3.4",
        "arkitecht/laravel-twilio": "^1.0",
        "barryvdh/laravel-ide-helper": "*",
        "coingate/coingate-php": "^4.1",
        "doctrine/dbal": "^3.5",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.0",
        "laravel/pulse": "^1.2",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.7",
        "laravelcollective/html": "^6.3",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "mashape/unirest-php": "^3.0",
        "mercadopago/dx-php": "^2.5",
        "minishlink/web-push": "^8.0",
        "mollie/mollie-api-php": "^2.48",
        "monolog/monolog": "^3.0",
        "munafio/chatify": "^1.5",
        "nunomaduro/collision": "7.7",
        "obydul/laraskrill": "^1.2",
        "paymentwall/paymentwall-php": "^2.2",
        "phpunit/phpunit": "10.1.2",
        "predis/predis": "^2.2",
        "psr/simple-cache": "^2.0",
        "rachidlaasri/laravel-installer": "^4.1",
        "sentry/sentry-laravel": "^4.2",
        "spatie/laravel-google-calendar": "^3.5",
        "spatie/laravel-permission": "^5.7",
        "srmklive/paypal": "^3.0",
        "stripe/stripe-php": "^10.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/breeze": "^1.9",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Utilities/DistanceCalculator.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
